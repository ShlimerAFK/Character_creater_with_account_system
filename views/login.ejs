<div id="form_top_text_box">

    <h2>Welcome to the log in page!</h2>
    <p>Fill the information below to login</p>


</div>

<form id="form" action="./login" method="post">


    <div>
        <input placeholder="Username" type="text" id="username" name="username" pattern="^[a-öA-Ö0-9]{1,15}$">
    </div>

    <div>
        <input placeholder="Password" type="password" id="password" name="password" pattern="^[a-öA-Ö0-9]{3,15}$">
    </div>

    <button type="submit">Login</button>

</form>

<div id="form_bottom_textc_box" > 
    
    <p>Dont have an account? Create one here</p>

    <a href="/register"> Register</a>

 </div>