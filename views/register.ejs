<div id="form_top_text_box">

    <h2>Welcome to the register in page!</h2>
    <p>Fill the information below to create an account</p>


</div>

<form id="form" action="./register" method="post">


    <div>
        <input placeholder="Username" type="text" id="username" name="username" pattern="^[a-öA-Ö0-9]{1,15}$" title="Username cant use special charectars and must be between 1 and 15 characters">
    </div>

    <div>
        <input placeholder="Password" type="password" id="password" name="password" pattern="^[a-öA-Ö0-9]{3,15}$" title="Password must be between 3 and 20 characters and cant use special characters">
    </div>

    <div>
        <input placeholder="Repeat Password" type="password" id="rep_password" name="rep_password" pattern="^[a-öA-Ö0-9]{3,15}$">
    </div>

    <button type="submit">Register</button>

</form>

<div id="form_bottom_textc_box" > 
    
    <p>Already have an account? Log in here</p>

    <a href="/login"> Login</a>

 </div>